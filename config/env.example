# market-daily 环境变量模板
# 复制为 .env.local(本地,不入 git)或在 GitHub Secrets 中配置同名变量。

# ===== 集思录账密登录(统一认证,替代旧 JISILU_COOKIE)=====
JISILU_USERNAME=
JISILU_PASSWORD=

# ===== 邮件 SMTP(QQ 邮箱 465,SMTP_PASS 是授权码非登录密码)=====
SMTP_USER=
SMTP_PASS=
RECEIVER_EMAIL=          # 逗号分隔多个收件人
EMAIL_FROM=              # 可选,默认 = SMTP_USER
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465

# ===== 异常报警 webhook(唯一;日报不再走 webhook,只报警)=====
ALERT_WEBHOOK=

# ===== 板块可选配置 =====
# 果仁行业估值(market-daily 市场估值板块)
GUORN_COOKIE=
# 东财选股补充池(可选,无 cookie 时用 fingerprint 兜底)
EASTMONEY_XUANGU_COOKIE=
# 高股息 TTM 归母净利润阈值(亿),默认 10
TTM_PARENT_NET_PROFIT_MIN_YI=10
# 东财补充池 xcid
DIVIDEND_EMAIL_SUPPLEMENT_XCID=xc12fd39e81b0700714b
# 东财补充池本地 PE-TTM 上限(超过则剔除,空值保留),默认 15
DIVIDEND_SUPPLEMENT_PE_TTM_MAX=15
# 国资白名单 Excel 路径(默认 data/whitelist/ 下)
STATE_OWNED_WHITELIST_XLSX=
# 巨潮财报抓取
CNINFO_FETCH_MAX_RETRIES=3
CNINFO_FETCH_BACKOFF_SECONDS=2
CNINFO_CACHE_MAX_AGE_DAYS=30

# ===== 板块配置/输出路径(按需)=====
# VALUATION_CONFIG=config/valuation.yaml
# CB_THREE_LOW_CONFIG=src/convertible/three_low/config.yaml
# ETF_ROTATION_20D_CONFIG=src/rotation/config.yaml
